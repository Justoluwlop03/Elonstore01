# Copy this file to backend/.env and fill in the values. Never place it in public/.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://justoluwlop_db_user:JP5uaDSRnTlkBj3g@cluster0.sufu0cz.mongodb.net/?appName=Cluster0
CORS_ORIGIN=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Use a randomly generated secret of at least 32 bytes.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=30d

# Required to create an administrator through /admin/signup. Use a long random value.
ADMIN_INVITE_CODE=replace_with_a_long_random_invite_code


# Paystack secret keys are server-only. Obtain test keys from the Paystack dashboard.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_test_secret
# Where Paystack sends customers after payment.
FRONTEND_URL=http://localhost:5173

# Brevo transactional email. The sender must be verified in Brevo.
BREVO_API_KEY=xkeysib_replace_with_your_brevo_api_key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Fijabi Electronics
# Public URL of this API, used in verification and reset links.
BACKEND_URL=http://localhost:5000
